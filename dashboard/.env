# Server Configuration Only
# Client configuration is handled by src/client_config.json
# Everything runs on the laptop, so localhost is fine for the dashboard.
REACT_APP_SERVER_URL=http://127.0.0.1:5000
REACT_APP_SERVER_HOST=127.0.0.1
REACT_APP_SERVER_PORT=5000
# Raw TCP port the FL clients connect to (server/server.py)
REACT_APP_FL_PORT=8765
HOST=0.0.0.0
